# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# SQL Server (local Docker instance)
# Must satisfy SQL Server's SA password policy: 8+ chars from 3 of {upper, lower, digit, symbol}.
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=DevPass123!
DB_NAME=clinicos
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# Local dev only: the `sa` login can create the `clinicos` database itself on first connect.
DB_AUTO_CREATE_DATABASE=true

# --- Hosted / managed SQL Server (SmarterASP.NET, Azure SQL, etc.) ---
# Map an ADO.NET connection string to the vars above, e.g.
#   Data Source=SQL1002.site4now.net;Initial Catalog=db_myclinic;User Id=db_myclinic_admin;
#   Password=...;Encrypt=True;TrustServerCertificate=True;
# becomes:
#   DB_HOST=SQL1002.site4now.net
#   DB_PORT=1433
#   DB_USER=db_myclinic_admin
#   DB_PASSWORD=...
#   DB_NAME=db_myclinic
#   DB_ENCRYPT=true
#   DB_TRUST_SERVER_CERTIFICATE=true
#   DB_AUTO_CREATE_DATABASE=false
# The database is already provisioned by the host and the login usually has no access to
# `master`, so DB_AUTO_CREATE_DATABASE must be "false" — run `npm run db:migrate` instead to
# create the schema inside the existing database.

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Seed: initial Super Admin account
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_EMAIL=superadmin@clinicos.local

# Seed: demo clinic staff (all roles use this password unless noted)
DEMO_USER_PASSWORD=Passw0rd!
